# Copy this file to .env.local (recommended) or .env.development for local work.
# Do not commit files containing real values.

# Canonical site URL for metadata, sitemap, robots and JSON-LD.
# Required in production (set the live origin, e.g. https://rafaelsousa.vercel.app).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# EmailJS (contact form) — public identifiers, not private secrets.
# Restrict allowed origins in the EmailJS dashboard.
NEXT_PUBLIC_EMAILJS_USER_ID=
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=

# Plausible Analytics domain (optional). Leave empty to disable the script.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
